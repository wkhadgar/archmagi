{
  "layer": "top",
  "position": "top",
  "spacing": 10,

  "modules-left": ["custom/nerv", "mpris", ],
  "modules-center": ["hyprland/workspaces",],
  "modules-right": ["tray", "custom/div", "wireplumber", "network", "bluetooth", "battery", "clock", "custom/updates", "group/group-power",],

  "custom/nerv": {
    "format": " NERV ",
    "tooltip": false,
  },

  "custom/div" : {
    "format": "|",
  },

  "custom/updates" : {
    "exec": "~/.local/bin/archmagi update check -j",
    "return-type": "json",
    "format": "{icon} {alt}",
    "format-icons": [
      "<span color='#ffffff'>󰚰</span>",
      "<span color='#e8f5e9'>󰚰</span>",
      "<span color='#c8e6c9'>󰚰</span>",
      "<span color='#a5d6a7'>󰚰</span>",
      "<span color='#81c784'>󰚰</span>",
      "<span color='#bbdefb'>󰚰</span>",
      "<span color='#90caf9'>󰚰</span>",
      "<span color='#64b5f6'>󰚰</span>",
      "<span color='#42a5f5'>󰚰</span>",
      "<span color='#fff9c4'>󰚰</span>",
      "<span color='#fff59d'>󰚰</span>",
      "<span color='#fff176'>󰚰</span>",
      "<span color='#ffee58'>󰚰</span>",
      "<span color='#ffd54f'>󰚰</span>",
      "<span color='#ffb74d'>󰚰</span>",
      "<span color='#ff9800'>󰚰</span>",
      "<span color='#f4511e'>󰚰</span>",
      "<span color='#e53935'>󰚰</span>",
      "<span color='#c62828'>󰚰</span>",
      "<span color='#b71c1c'>󰚰</span>"
    ],
    "interval": 3600,
    "on-click": "kitty -e ~/.local/bin/archmagi update; ~/.local/bin/archmagi restart waybar",
    "hide-empty-text": true,
  },

  "hyprland/window": {
    "format": "{title}",
    "tooltip-format": "{title}",
    "icon": true,
    "separate-outputs": true,
    "icon-size": 20,
    "max-length": 50,
  },

  "hyprland/workspaces": {
    "format": " [{id}] {windows} ",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "discord": " ",
      "title<.*nvim.*>": "",
      "firefox":"󰈹",
      "title<.*github.*>": "",
      "kitty": "",
      "archmagi-hud": "󰣖",
      "org\\.telegram\\.desktop": "",
      "Spotify": "",
    },
  },

  "mpris": {
    "format": " {player_icon}  {dynamic} ",
    "format-paused": " {status_icon}  <i>{dynamic}</i> ",
    "dynamic-separator": "  ",
    "dynamic-order": [
      "title", 
      "album",
      "artist", 
    ],
    "title-len": 30,
    "album-len": 30,
    "artist-len": 30,
    "player-icons": {
      "default": "󰐎",
      "mpv": "🎵",
      "chromium": "",
      "spotify": "",
    },
    "status-icons": {
      "paused": ""
    },
  },

  "wireplumber": {
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      " ",
    ],
    "format-muted": " ",
    "tooltip-format": "{node_name}: {volume}%",
    "on-click": "kitty pulsemixer",
    "max-volume": 100,
    "scroll-step": 5
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} — {power:.1f}W",
    "on-click": "~/.local/bin/archmagi profile",
  },

  "clock": {
    "format": "{:%H:%M %d/%m}",
    "tooltip-format": "{:%A, %d %B}"
  },

  "network": {
    "interval": 5,
    "format": "{icon}",
    "on-click": "kitty nmtui",
    "format-disconnected": "󰲜 E",
    "format-ethernet": "󰲝 E",
    "format-wifi": "{icon}",
    "format-icons": ["󰤯 W", "󰤟 W", "󰤢 W", "󰤥 W", "󰤨 W"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}: {bandwidthDownBytes}",
    "tooltip-format-disconnected": "Disconnected",
  },

  "bluetooth": {
    "on-click": "kitty bluetui",
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂰",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },

  "tray": {
    "show-passive-items": true,
    "icon-size": 16,
    "spacing": 16
  },

  "group/group-power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/power", // First element is the "group leader" and won't ever be hidden
      "custom/lock",
      "custom/reboot",
      "custom/exit",
    ]
  },


  "custom/lock": {
    "format": "󰍁",
    "tooltip": false,
    "on-click": "~/.local/bin/archmagi lock"
  },

  "custom/reboot": {
    "format": "󰜉",
    "tooltip": false,
    "on-click": "~/.local/bin/archmagi reboot"
  },

  "custom/exit": {
    "format": "󰗼",
    "tooltip": false,
    "on-click": "~/.local/bin/archmagi exit"
  },

  "custom/power": {
    "format": " ",
    "tooltip": false,
    "on-click": "~/.local/bin/archmagi shutdown"
  },
}
