#!/bin/bash
# archmagi — unified NERV/MAGI command interface (dispatcher).
# Each command group lives in bin/archmagi.d/<group>.sh and is sourced lazily.
# Shared palette + helpers come from bin/archmagi.d/lib.sh.

ARCHMAGI_LIB="${ARCHMAGI_LIB:-$(dirname "$(readlink -f "$0")")/archmagi.d}"
[[ -d $ARCHMAGI_LIB ]] || { echo "archmagi: lib dir not found at $ARCHMAGI_LIB" >&2; exit 1; }

source "$ARCHMAGI_LIB/lib.sh"

# Note: `source` MUST happen at top scope, not inside a function. `declare -A`
# inside a sourced file becomes function-local when invoked through a function
# wrapper — the associative arrays in profile.sh would evaporate before the
# subcommand runs. Inline the source here.

cmd="${1:-help}"; shift || true
case "$cmd" in
    fetch|tailnet|update|confirm|restart|install|cheatsheet|tmux|profile|hud)
        source "$ARCHMAGI_LIB/$cmd.sh"; "cmd_$cmd" "$@" ;;
    lock|reboot|exit|shutdown)
        source "$ARCHMAGI_LIB/power.sh"; "cmd_$cmd" "$@" ;;
    help|-h|--help)
        source "$ARCHMAGI_LIB/help.sh"; cmd_help ;;
    *)
        echo "archmagi: unknown command: $cmd" >&2
        source "$ARCHMAGI_LIB/help.sh"; cmd_help >&2
        exit 1 ;;
esac
