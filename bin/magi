#!/bin/bash
# magi — unified NERV/MAGI command interface (dispatcher).
# Each command group lives in bin/magi.d/<group>.sh and is sourced lazily.
# Shared palette + helpers come from bin/magi.d/lib.sh.

MAGI_LIB="${MAGI_LIB:-$(dirname "$(readlink -f "$0")")/magi.d}"
[[ -d $MAGI_LIB ]] || { echo "magi: lib dir not found at $MAGI_LIB" >&2; exit 1; }

source "$MAGI_LIB/lib.sh"

_magi_load() { source "$MAGI_LIB/$1.sh"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
    status|tailnet|update|confirm|restart|install|cheatsheet|tmux|profile)
        _magi_load "$cmd"; "cmd_$cmd" "$@" ;;
    lock|reboot|exit|shutdown)
        _magi_load power; "cmd_$cmd" "$@" ;;
    help|-h|--help)
        _magi_load help; cmd_help ;;
    *)
        echo "magi: unknown command: $cmd" >&2
        _magi_load help; cmd_help >&2
        exit 1 ;;
esac
