#!/bin/bash
# .githooks/pre-commit
#
# Runs tests/smoke.sh when any magi-related file is staged. Other commits
# pass through instantly. Enable with:
#     git config core.hooksPath .githooks
#
# Bypass for one commit with:  git commit --no-verify

repo_root=$(git rev-parse --show-toplevel) || exit 0
cd "$repo_root" || exit 0

# Trigger only if magi (or the smoke test itself) is in this commit.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(bin/archmagi(\.d/.*)?|tests/smoke\.sh)$'; then
    exit 0
fi

echo "magi files staged — running smoke test…" >&2
if ! ./tests/smoke.sh >&2; then
    echo                                                          >&2
    echo "magi smoke test failed — commit aborted."               >&2
    echo "Fix the failure or skip with: git commit --no-verify."  >&2
    exit 1
fi

exit 0
