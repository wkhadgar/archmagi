
################
### MONITORS ###
################

# See https://wiki.hyprland.org/Configuring/Monitors/
#
# Fallback "use whatever's connected at its preferred mode" — Hyprland will
# auto-arrange and use native resolution for each plugged output. Replace with
# explicit per-monitor rules after first login via:
#
#     archmagi install monitors
#
# which writes the live hyprctl monitor state into this file.

monitor=,preferred,auto,1
