animation = fade, 1, 4, linear

background {
  monitor =
  path = screenshot
  color = rgba(0a0a0aff)
  blur_passes = 2
}

label {
  monitor =
  text = [ __HOSTNAME_UPPER__ ]
  color = rgba(cc0000ff)
  font_size = 16
  font_family = JetBrains Mono
  position = 0, 180
  halign = center
  valign = center
}

label {
  monitor =
  text = ⚠ AUTHORIZED PERSONNEL ONLY ⚠
  color = rgba(666666cc)
  font_size = 11
  font_family = JetBrains Mono
  position = 0, 155
  halign = center
  valign = center
}

label {
  monitor =
  text = cmd[update:1000] echo "$(date +"%H:%M")"
  color = rgba(ffbf00ff)
  font_size = 96
  font_family = JetBrains Mono Bold
  position = 0, 40
  halign = center
  valign = center
}

label {
  monitor =
  text = cmd[update:60000] echo "$(date +"%A // %d %B %Y" | tr '[:lower:]' '[:upper:]')"
  color = rgba(cc0000cc)
  font_size = 13
  font_family = JetBrains Mono
  position = 0, -70
  halign = center
  valign = center
}

input-field {
  monitor =
  size = 300, 44
  outline_thickness = 1
  dots_size = 0.25
  dots_spacing = 0.3
  dots_center = true
  outer_color = rgba(ffbf00ff)
  inner_color = rgba(0a0a0aff)
  font_color = rgba(ffbf00ff)
  fade_on_empty = true
  rounding = 0
  check_color = rgba(ffbf00ff)
  fail_color = rgba(cc0000ff)
  placeholder_text = <span foreground="##444444">PASSWORD</span>
  hide_input = false
  position = 0, -140
  halign = center
  valign = center
}

